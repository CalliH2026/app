<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>New PRONOTE · Calli</title><link rel="icon" href="/static/parallel-symbol.svg"><link rel="stylesheet" href="/static/workspace.css?v=grading-voice-final-20261107"><link rel="stylesheet" href="/static/outings.css?v=readable-1"><link rel="stylesheet" href="/static/outings-readable.css?v=2"><link rel="stylesheet" href="/static/background.css"><link rel="stylesheet" href="/static/native-preparation.css"><link rel="stylesheet" href="/static/practice.css"><link rel="stylesheet" href="/static/report.css?v=readable-tools-2"><link rel="stylesheet" href="/static/sponsors.css?sponsors=20261107"><link rel="stylesheet" href="/static/calli-shell.css?v=math-1"><link rel="stylesheet" href="/static/outing-checkout.css"><link rel="stylesheet" href="/static/vendor/katex/katex.min.css"></head>
<body><div class="workspace">
<aside class="rail"><a class="brand" href="/" aria-label="New Pronote, accueil"><span class="brand-symbol">n<span>p</span></span><span>new<br><b>pronote</b><i>CONCEPT INDÉPENDANT</i></span></a><div class="school-switch"><span class="school-icon">T</span><div>Collège des Tilleuls<small>Espace professeur</small></div><span class="chevron">⌄</span></div><nav id="navigation" aria-label="Navigation principale"><button class="nav active" data-page="today" title="Aujourd’hui"><span data-icon="home"></span>Aujourd’hui</button><button class="nav" data-page="management" title="Élèves et évaluations"><span data-icon="users"></span>Mes élèves</button><button class="nav" data-page="appreciations" title="Appréciations"><span data-icon="message"></span>Appréciations</button><button class="nav" data-page="family" title="Ma famille (vue parent, démonstration)"><span data-icon="users"></span>Ma famille</button><button class="nav" data-page="agenda" title="Agenda"><span data-icon="calendar"></span>Agenda</button><button class="nav" data-page="outings" title="Sorties scolaires"><span data-icon="pin"></span>Sorties scolaires</button><button class="nav" data-page="messages" title="Discussions"><span data-icon="message"></span>Discussions <i>3</i></button></nav><div class="rail-rule"></div><button class="nav" data-page="agent" title="Assistant Calli"><img class="calli-symbol parallel-nav-logo" src="/static/brand/calli-symbol.svg" alt="">Calli <i id="parallel-indicator">●</i></button><button class="nav" data-page="reports" title="Rapports"><span data-icon="file"></span>Rapports <i id="report-count">0</i></button><details class="more-navigation"><summary>Plus</summary><button class="nav" data-page="classes" title="Mes classes"><span data-icon="users"></span>Mes classes</button><button class="nav" data-page="evaluations" title="Évaluations"><span data-icon="file"></span>Évaluations</button><button class="nav" data-page="documents" title="Documents"><span data-icon="folder"></span>Documents</button></details><div class="rail-bottom"><form id="logout-form" action="/auth/logout" method="post" hidden><button class="nav" type="submit" title="Se déconnecter">Se déconnecter</button></form><button id="connection-button" class="connection"><span class="live-dot"></span><span id="connection-label">Espace de démonstration</span><span>↗</span></button><button id="settings-button" class="profile"><span class="avatar lilac">ML</span><span>Mme Laurent <em class="role-tag">Enseignante</em><small>Mathématiques</small></span><span data-icon="settings"></span></button></div></aside>
<div class="center"><header class="topbar"><div class="breadcrumb" id="breadcrumb">Votre espace <span>/</span> Aujourd’hui</div><div class="top-actions"><button class="search-button" id="search-button"><span data-icon="search"></span><span>Rechercher un document</span><kbd>⌘ K</kbd></button><button class="agent-switch" id="agent-switch"><img class="calli-symbol" src="/static/brand/calli-symbol.svg" alt="Calli, votre assistant"><span id="agent-switch-label">Calli veille à la suite</span><i class="live-dot"></i></button></div></header><div class="demo-note"><span class="demo-pill">DÉMO</span> Démonstration partagée · données fictives · préparations réelles en mode connecté.<button id="source-info">Voir les connexions <span>↗</span></button></div><main id="main" tabindex="-1"><div class="loading">Chargement de votre espace…</div></main></div>
<aside class="agent-panel" id="agent-panel"><div class="agent-head"><div class="h-mark"><img class="calli-symbol" src="/static/brand/calli-symbol.svg" alt="Calli, votre assistant"></div><div><strong>Calli</strong><small class="sponsor-credit">Votre agent · avec <span data-sponsor="hcompany">H Company</span></small></div><button class="icon-button" id="close-agent" aria-label="Fermer le volet" data-icon="close"></button></div><div class="agent-state"><span class="live-dot"></span><span id="agent-state">À l’écoute de votre journée</span><button class="agent-recording-link" id="view-agent">Voir l’agent ↗</button></div><div class="parallel-presence" id="parallel-presence"><span class="parallel-pulse"></span><div><strong id="parallel-action">À l’écoute du dossier</strong><small id="parallel-detail">Chaque action reste accessible.</small></div><button id="view-recordings" aria-label="Voir les enregistrements">▶</button></div><div id="agent-content" class="agent-content"></div><div class="agent-footer" id="agent-footer" hidden><button id="dismiss" class="button secondary">Dismiss <span>Plus tard</span></button><button id="keep" class="button primary">Keep <span>Garder le rapport</span></button></div></aside>
</div>
<div class="parallel-dock" id="parallel-dock"><div class="dock-mark"><img class="calli-symbol" src="/static/brand/calli-symbol.svg" alt="Calli, votre assistant"></div><button id="parallel-follow"><strong id="dock-title">Calli veille</strong><small id="dock-detail">Votre agent reste à côté de vous.</small></button><button id="parallel-watch" aria-label="Voir les sessions de l’agent">▶</button></div>
<div class="toast" id="toast" role="status" hidden><img class="calli-symbol toast-parallel-logo" src="/static/brand/calli-symbol.svg" alt="Calli, votre assistant"><div><strong id="toast-title"></strong><p id="toast-message"></p><div class="toast-actions"><button id="toast-open">Voir le rapport ↗</button><button id="toast-dismiss">Dismiss</button><button id="toast-keep">Keep</button></div></div><button id="toast-close" aria-label="Masquer">×</button></div><div id="feedback" class="feedback" role="status" hidden></div>
<dialog id="settings-dialog"><div class="dialog-head"><span class="overline">VOTRE ESPACE DE TRAVAIL</span><button class="icon-button" data-close="settings-dialog" data-icon="close" aria-label="Fermer"></button></div><h2>Calli, à votre façon.</h2><p>Ouvrir la copie suffit à lancer la préparation. Vous pouvez poursuivre votre travail et retrouver le résultat ici.</p><label>Question jointe au dossier<select id="voice"><option value="points">Pourquoi perd-il des points alors que son résultat est juste ?</option><option value="progress">Comment peut-il progresser ?</option></select></label><audio id="voice-preview" controls src="/audio/points"></audio><label>Préparation<select id="execution"><option value="live">Connectée · H + Gladia + Linkup</option><option value="demo">Hors ligne · scénario de démonstration</option></select></label><div class="sponsor-row" id="execution-sponsors" aria-label="Services du mode connecté"><span data-sponsor="hcompany">H Company</span><span data-sponsor="gladia">Gladia</span><span data-sponsor="linkup">Linkup</span></div><label>Rendu vidéo<select id="renderer"><option value="local">Python + FFmpeg · local</option><option value="demobro">DemoBro MCP · cloud</option></select></label><button id="notifications" class="button secondary full">Activer les notifications macOS ↗</button><p id="notification-note" class="fine">Keep et Dismiss restent disponibles dans l’interface.</p></dialog>
<dialog id="connection-dialog"><div class="dialog-head"><span class="overline">DONNÉES & CONNEXIONS</span><button class="icon-button" data-close="connection-dialog" data-icon="close" aria-label="Fermer"></button></div><h2>Chaque action, une trace.</h2><div id="connection-content"></div></dialog>
<dialog id="source-dialog"><div class="dialog-head"><span class="overline">VERSION UTILISÉE PAR H</span><button class="icon-button" data-close="source-dialog" data-icon="close" aria-label="Fermer"></button></div><div id="source-content"></div></dialog>
<dialog id="search-dialog"><div class="dialog-head"><span class="overline">RECHERCHER DANS LE DOSSIER</span><button class="icon-button" data-close="search-dialog" data-icon="close" aria-label="Fermer"></button></div><input type="search" id="search-input" placeholder="Copie, barème, consigne…" aria-label="Rechercher"><div id="search-results"></div></dialog>
<dialog id="recording-dialog"><div class="dialog-head"><span class="overline">SESSION DE L’AGENT</span><button class="icon-button" data-close="recording-dialog" data-icon="close" aria-label="Fermer"></button></div><div id="recording-content"></div></dialog>
<dialog id="management-dialog"><div class="dialog-head"><span class="overline">GESTION LOCALE</span><button class="icon-button" data-close="management-dialog" data-icon="close" aria-label="Fermer"></button></div><div id="management-form"></div></dialog>
