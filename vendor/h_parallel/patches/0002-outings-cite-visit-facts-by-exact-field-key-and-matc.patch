+++ b/mvp/test_outings.py
@@ -187,3 +187,60 @@ def test_closure_and_overnight_visits_are_not_marked_valid(store, destination):
     job['visit']['opening_time'] = None
     job.update(budget={'complete': True}, warnings=[])
