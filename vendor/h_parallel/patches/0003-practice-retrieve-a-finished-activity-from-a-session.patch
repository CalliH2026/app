                 return httpx.Response(status_code, json={'detail': 'secret-api-key private provider detail'})
             return httpx.Response(200, json={'session_id': session_id, 'status': 'new', **({'url': url} if url else {})})
         if request.url.path.endswith('/attachments'):
-            return httpx.Response(200, json=[{'attachment_id': 'file-1', 'name': 'activity.html',
-                'source': 'devin', 'url': 'https://storage.googleapis.com/devin-files/activity.html?secret=SIGNED'}])
-        return httpx.Response(200, json={'session_id': session_id, 'status': 'running', 'status_detail': 'finished',
-            'acus_consumed': .4, 'structured_output': {'artifact_name': 'activity.html',
+            return httpx.Response(200, json=attachments if attachments is not None else [{'attachment_id': 'file-1',
+                'name': 'activity.html', 'source': 'devin',
